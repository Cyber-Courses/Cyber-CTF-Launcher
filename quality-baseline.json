  "exceptions": {
    "src-tauri/src/commands.rs": {
      "#![allow(clippy::needless_pass_by_value, reason = \"Tauri hands a command its arguments by value\")]": 1,
      "#[allow(clippy::too_many_lines, reason = \"one line per command: a list, not logic\")]": 1
    },
    "src-tauri/src/commands/labs.rs": {
      "#[allow(clippy::too_many_arguments, reason = \"the webview sends each of the request's fields as an argument\")]": 1
    },
    "src-tauri/src/commands/terminal.rs": {
      "#[allow(clippy::too_many_arguments, reason = \"the webview sends each of the shell's fields as an argument\")]": 1
    },
    "src-tauri/src/machine/system/wsl.rs": {
      "#![cfg_attr(not(windows), allow(dead_code, reason = \"off Windows only the UI's types and the tests use most of this\"))]": 1,
      "#[cfg_attr(not(windows), allow(clippy::unused_async, reason = \"it awaits the probes on Windows\"))]": 1,
      "#[cfg_attr(not(windows), allow(clippy::unused_async, reason = \"it awaits the restart on Windows\"))]": 1
    },
    "src-tauri/src/platform/exec/fake.rs": {
      "#[allow(clippy::unnecessary_wraps, reason = \"a script answers an Option, None being a missing tool\")]": 2
    },
    "src-tauri/src/platform/exec/group.rs": {
      "#[cfg_attr(not(unix), allow(dead_code, reason = \"only unix stops a streamed tool gently, with SIGTERM\"))]": 1
    },
    "src-tauri/src/platform/sys.rs": {
      "#![allow(unsafe_code, reason = \"the audited home of the launcher's calls into libc and Win32\")]": 1
    },
    "src-tauri/src/runtime/exegol.rs": {
      "#[cfg_attr(not(target_os = \"macos\"), allow(dead_code))]": 1,
      "#[cfg_attr(not(windows), allow(dead_code))]": 5
    },
    "src-tauri/src/runtime/launch.rs": {
      "#[allow(clippy::too_many_arguments)]": 2
    },
    "src/app/layout.tsx": {
      "eslint-disable-next-line @next/next/no-sync-scripts -- must run before first paint to avoid a flash of the wrong mode": 1
    },
    "src/components/command-palette.tsx": {
      "eslint-disable-next-line @typescript-eslint/no-deprecated -- WebKit (the macOS webview) sends the Enter that ends a composition with isComposing false; keyCode 229 is its only mark": 1
    },
    "src/components/shell/use-shell-setup.ts": {
      "eslint-disable-next-line react-hooks/set-state-in-effect -- read once on mount: the window marker and localStorage don't exist during the static render": 1
    },
    "src/features/cloud/account-row.tsx": {
      "eslint-disable-next-line @next/next/no-img-element -- static export, plain asset": 1
    },
    "src/features/labs/network-diagram/fit-width.tsx": {
      "eslint-disable-next-line react-hooks/set-state-in-effect -- read once on mount: localStorage doesn't exist during the static render": 1
    },
    "src/features/labs/network-diagram/index.tsx": {
      "eslint-disable-next-line react-hooks/exhaustive-deps -- sig captures everything drawn": 1
    },
    "src/features/labs/run-on-options.tsx": {
      "eslint-disable-next-line @next/next/no-img-element -- static export, plain asset": 2
    },
    "src/features/machine/hypervisor-logo.tsx": {
      "eslint-disable-next-line @next/next/no-img-element -- static export, plain asset": 1
    },
    "src/features/machine/setup-steps/engine-step.tsx": {
