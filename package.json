{
  "name": "cyber-ctf-desktop",
  "version": "1.8.9",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^25.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3206",
    "build": "next build",
    "lint": "eslint src scripts tests",
    "format": "pnpm format:check --write && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check \"{src,scripts,tests}/**/*.{ts,tsx,css,mjs}\" \"{*,docs/**/*,infra/**/*,scripts/**/*,tests/**/*}.md\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check:tauri": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check/tauri-versions.ts",
    "check:docs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check/doc-links.ts",
    "quality": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/quality/main.ts",
    "check": "SKIP=e2e-native scripts/release/release-check.sh",
    "release-check": "scripts/release/release-check.sh",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:watch": "vitest",
    "test:web": "playwright test",
    "test:desktop": "tests/desktop/run.sh",
    "test:integration": "tests/integration/run.sh",
    "notices": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/release/third-party.ts notices",
    "sbom": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/release/third-party.ts sbom"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.3",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "elkjs": "^0.12.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "webdriverio": "^10.1.0"
  },
  "packageManager": "pnpm@10.30.3"
}
