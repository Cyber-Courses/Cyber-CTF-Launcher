{
  "name": "cyber-ctf-desktop",
  "version": "1.8.9",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^25.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts e2e",
    "format": "prettier --write \"{src,scripts,e2e}/**/*.{ts,tsx,css,mjs}\" \"{*,docs/**/*,infra/**/*,scripts/**/*}.md\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "typecheck": "next typegen && tsc --noEmit",
    "check:tauri": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-tauri-versions.ts",
    "check:docs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-doc-links.ts",
    "check": "pnpm check:tauri && pnpm check:docs && prettier --check \"{src,scripts,e2e}/**/*.{ts,tsx,css,mjs}\" \"{*,docs/**/*,infra/**/*,scripts/**/*}.md\" && pnpm typecheck && cargo fmt --manifest-path src-tauri/Cargo.toml --check && pnpm quality && vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "quality": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/quality/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:desktop": "e2e/desktop/run.sh",
    "release-check": "scripts/release-check.sh",
    "test:integration": "scripts/integration-tests.sh",
    "notices": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/third-party.ts notices",
    "sbom": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/third-party.ts sbom"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-deep-link": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.50.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "webdriverio": "^10.1.0"
  },
  "packageManager": "pnpm@10.30.3"
}
