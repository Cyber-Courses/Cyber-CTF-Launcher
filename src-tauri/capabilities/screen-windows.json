{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screen-windows",
  "description": "the lab machines' screen windows: close, drag, and their screen (screen-window set); no opener, the screen opens no links",
  "windows": [
    "screen-*"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "screen-window"
  ]
}
