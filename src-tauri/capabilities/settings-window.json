{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "the Settings window: app version and updates, sign-in events to the main window, links, close and drag; its app commands are the settings-window set",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "updater:default",
    "notification:default",
    "dialog:allow-open",
    "core:window:allow-set-theme",
    "settings-window"
  ]
}
