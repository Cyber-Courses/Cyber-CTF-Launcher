{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "machine-setup-window",
  "description": "the machine setup window: close itself, drag, notify the main window, and the machine-setup-window commands",
  "windows": [
    "machine-setup"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:allow-open",
    "core:window:allow-set-theme",
    "machine-setup-window"
  ]
}
