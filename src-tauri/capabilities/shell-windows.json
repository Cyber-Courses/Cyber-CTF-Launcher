{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell-windows",
  "description": "the attack box shell windows: close, drag, open links, and their terminal (shell-window set)",
  "windows": [
    "shell-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "core:window:allow-set-theme",
    "shell-window"
  ]
}
