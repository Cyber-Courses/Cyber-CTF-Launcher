{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the main window: core and plugin permissions, and the app commands of every screen (main-window in permissions/windows.toml)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "deep-link:default",
    "updater:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    },
    "dialog:allow-open",
    "core:window:allow-set-theme",
    "main-window"
  ]
}
