{
  "$schema": "https://raw.githubusercontent.com/isoloom/isoloom/main/schemas/run-manifest-v1.schema.json",
  "manifest_version": 1,
  "generator": {
    "name": "isoloom",
    "version": "1.0.9"
  },
  "environment": {
    "name": "solo-web",
    "instance": null,
    "message": null
  },
  "target": "cloud-docker",
  "cloud": "gcp",
  "driver": "terraform",
  "hosts": [
    "linux",
    "macos",
    "windows"
  ],
  "tools": [
    {
      "name": "terraform",
      "probe": [
        "terraform",
        "version"
      ],
      "min_version": "1.11.0"
    },
    {
      "name": "ssh",
      "probe": [
        "ssh",
        "-V"
      ]
    }
  ],
  "identity": {
    "terraform": {
      "module": ".",
      "state": "runner"
    }
  },
  "params": [
    {
      "name": "project",
      "description": "An existing project; or leave empty and give billing_account for a project of its own.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "project"
        }
      ]
    },
    {
      "name": "billing_account",
      "description": "With no project: create one for this environment, billed here, deleted with it.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "billing_account"
        }
      ]
    },
    {
      "name": "org_id",
      "description": "The module's `org_id`.",
      "default": "",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "org_id"
        }
      ]
    },
    {
      "name": "region",
      "description": "The module's `region`.",
      "default": "europe-west9",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "region"
        }
      ]
    },
    {
      "name": "machine_type",
      "description": "The module's `machine_type`.",
      "default": "e2-medium",
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "machine_type"
        }
      ]
    },
    {
      "name": "allowed_cidr",
      "description": "Who may reach the machines (SSH and the published ports), e.g. your IP/32.",
      "required": true,
      "set_by": "embedder",
      "deliver": [
        {
          "via": "tf_var",
          "var": "allowed_cidr"
        }
      ]
    },
    {
      "name": "ISOLOOM_DERIVED",
      "description": "0: the checks derived from the spec (reachability, no internet) are skipped.",
      "default": "1",
      "values": [
        "0",
        "1"
      ],
      "set_by": "embedder",
      "deliver": [
        {
          "via": "env",
          "var": "ISOLOOM_DERIVED",
          "steps": [
            "check-networks"
          ]
        }
      ]
    }
  ],
  "secrets": [
    {
      "name": "GOOGLE_OAUTH_ACCESS_TOKEN",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_OAUTH_ACCESS_TOKEN"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_OAUTH_ACCESS_TOKEN",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "GOOGLE_CREDENTIALS",
      "kind": "connection",
      "required": false,
      "sensitive": true,
      "source": {
        "store": "env",
        "reference": "GOOGLE_CREDENTIALS"
      },
      "deliver": [
        {
          "via": "env",
          "var": "GOOGLE_CREDENTIALS",
          "steps": [
            "init",
            "apply",
            "destroy"
          ]
        }
      ]
    },
    {
      "name": "FLAG",
      "kind": "input",
      "required": false,
      "sensitive": true,
      "machines": [
        "web"
      ],
      "default": "",
      "deliver": [
        {
          "via": "guest",
          "machine": "web",
          "transport": "ssh"
        }
      ]
    }
  ],
  "networks": [
    {
      "name": "app",
      "cidr": "10.80.0.0/24",
      "internet": true,
      "native": "solo-web_app"
    }
  ],
  "machines": [
    {
      "name": "isoloom-docker-host",
      "role": "infra",
      "resources": {
        "cpus": 2,
        "memory_mb": 2048
      },
      "addresses": {}
    },
    {
      "name": "web",
      "role": "member",
      "arch": "amd64",
      "resources": {
        "cpus": 1,
        "memory_mb": 512
      },
      "addresses": {
        "app": "10.80.0.10"
      },
      "native": {
        "service": "web"
      },
      "ports": [
        {
          "name": "web",
          "port": 80,
          "protocol": "tcp",
          "http": true,
          "publish": {
            "mode": "fixed",
            "preferred": 8080,
            "address": "${outputs.ip}"
          }
        }
      ]
    },
    {
      "name": "isoloom-check",
      "role": "check",
      "addresses": {},
      "native": {
        "service": "isoloom-check"
      }
    },
    {
      "name": "isoloom-probe-amd64",
      "role": "infra",
      "addresses": {},
      "native": {
        "service": "isoloom-probe-amd64"
      }
    }
  ],
  "lifecycle": {
    "up": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "apply",
        "note": "Creating the Docker host in the cloud…",
        "argv": [
          "terraform",
          "apply",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      },
      {
        "id": "docker",
        "note": "Installing Docker in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo sh -s",
          "host": "${outputs.ip}",
          "user": "admin",
          "wait_s": "300"
        },
        "stdin": "setup.sh",
        "timeout_s": 1800
      },
      {
        "id": "archive",
        "note": "Archiving the project…",
        "action": "project.archive",
        "with": {
          "root": "../../.."
        }
      },
      {
        "id": "project",
        "note": "Copying the project into the VM…",
        "action": "ssh.run",
        "with": {
          "command": "sudo rm -rf /opt/isoloom && sudo mkdir -p /opt/isoloom && sudo tar -xzf - -C /opt/isoloom",
          "host": "${outputs.ip}",
          "user": "admin"
        },
        "stdin": "${run.state_dir}/project.tgz",
        "timeout_s": 600
      },
      {
        "id": "start",
        "note": "Starting the lab's containers in the VM…",
        "action": "ssh.run",
        "with": {
          "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name solo-web --file .isoloom/docker/compose.yml up --detach --build --pull missing --remove-orphans --wait --wait-timeout 600",
          "host": "${outputs.ip}",
          "user": "admin"
        },
        "timeout_s": 1800
      }
    ],
    "down": [
      {
        "id": "clear-lock",
        "action": "terraform.clear_lock"
      },
      {
        "id": "init",
        "note": "Preparing Terraform and its providers…",
        "argv": [
          "terraform",
          "init",
          "-input=false",
          "-no-color",
          "-backend-config=path=${run.state_dir}/terraform.tfstate"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 900
      },
      {
        "id": "destroy",
        "note": "Removing the lab from the cloud…",
        "argv": [
          "terraform",
          "destroy",
          "-auto-approve",
          "-input=false",
          "-no-color"
        ],
        "env": {
          "TF_DATA_DIR": "${run.state_dir}/.terraform",
          "TF_INPUT": "0",
          "TF_IN_AUTOMATION": "1",
          "TF_VAR_ssh_public_key": "${run.ssh_public_key}"
        },
        "timeout_s": 3600
      }
    ],
    "status": {
      "id": "state",
      "action": "terraform.read_state"
    }
  },
  "ready": [
    {
      "kind": "step_ok",
      "step": "apply",
      "means": "the Docker host exists and booted"
    },
    {
      "kind": "step_ok",
      "step": "start",
      "means": "every long-running service is healthy (`--wait`: each port's probe, the route keepers, the machines' own healthchecks)"
    }
  ],
  "outputs": [
    {
      "name": "ip",
      "description": "The Docker host's address: SSH reaches it there, and its containers' published ports answer there.",
      "role": "address",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ip"
      }
    },
    {
      "name": "ssh_user",
      "description": "The user the runner's key lets in on the Docker host.",
      "role": "info",
      "sensitive": false,
      "from": {
        "kind": "terraform_output",
        "name": "ssh_user"
      }
    },
    {
      "name": "web_web",
      "description": "web's web (port 80).",
      "role": "entry",
      "sensitive": false,
      "format": "http://${host.web}:${value}/",
      "from": {
        "kind": "published_port",
        "machine": "web",
        "port": "web"
      }
    }
  ],
  "checks": {
    "protocol": "isoloom-check/1",
    "setup": [],
    "runners": [
      {
        "id": "isoloom-check",
        "from": "from the environment's networks",
        "checks": [
          {
            "name": "checks/web-answers.sh",
            "kind": "script",
            "wait_s": 60,
            "derived": false
          }
        ],
        "step": {
          "id": "check-networks",
          "action": "ssh.run",
          "with": {
            "command": "cd /opt/isoloom && sudo -E env ISOLOOM_PUBLISH_ADDRESS=0.0.0.0 ISOLOOM_PUBLISH_FIXED=1 docker compose --project-name solo-web --file .isoloom/docker/compose.yml --profile check run --rm --no-deps --env ISOLOOM_DERIVED=${params.ISOLOOM_DERIVED} isoloom-check",
            "host": "${outputs.ip}",
            "user": "admin"
          },
          "timeout_s": 135
        },
        "on_timeout": [
          {
            "id": "rm-check-networks",
            "action": "ssh.run",
            "with": {
              "command": "sudo docker ps -aq --filter label=com.docker.compose.project=solo-web --filter label=com.docker.compose.service=isoloom-check --filter label=com.docker.compose.oneoff=True | xargs -r sudo docker rm -f",
              "host": "${outputs.ip}",
              "user": "admin"
            },
            "timeout_s": 60
          }
        ]
      }
    ],
    "teardown": []
  },
  "recovery": {
    "retries": 0,
    "apply_retries": 1
  },
  "expiry": {
    "tf_var": "expires_at",
    "unit": "unix_seconds",
    "default_minutes": 240
  },
  "guest": {
    "machine": "isoloom-docker-host",
    "host": "${outputs.ip}",
    "status": {
      "id": "ps",
      "action": "ssh.run",
      "with": {
        "command": "if command -v docker >/dev/null; then sudo docker compose --project-name solo-web ps --all --format json; fi",
        "host": "${outputs.ip}",
        "user": "admin"
      },
      "timeout_s": 60
    }
  }
}
