{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cyber CTF",
  "version": "1.5.2",
  "identifier": "org.cyberctf.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cyber CTF",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ]
      }
    },
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cyberctf"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Cyber-Courses/Cyber-CTF-Launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQzhGOTUxOTQ0MzAzRjQKUldUMEEwT1VVZm5JUFpyQjkzUUpScFh6MTRtM3FOTis0d1pwRXFWb0V5aVJEdG1NaXpCOVN6WmkK"
    }
  }
}
