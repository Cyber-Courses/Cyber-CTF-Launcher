{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The quality ratchet runs it by path from node_modules (scripts/quality/node-tools.ts).
  // webdriverio drives the native GUI e2e harness in tests/native/ (not part of the app bundle).
  "ignoreDependencies": ["jscpd", "webdriverio"],
  // Loaded by a <script> tag in src/app/layout.tsx, which knip doesn't read; tests/native/ is the
  // native GUI e2e harness, run on its own, not imported by the app.
  "ignore": ["public/appearance.js", "tests/native/**"],
}
